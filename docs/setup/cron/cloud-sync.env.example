# Copy to /mnt/ssd/secrets/cloud-sync.env on gp-hris (chmod 600).
# Do NOT commit real passwords.
#
# Temporary bridge while AS still use Vercel (.ph) and office uses on-prem (.com).
# Default: bidirectional INSERT-only merge (never overwrite). Disable after Tailscale/VPN cutover.

# --- Merge sync (default cron: sync-merge-cloud-local.sh) ---
MERGE_SYNC_ENABLED=1
# 1 = log would-insert counts only; 0 = actually INSERT missing rows
DRY_RUN=1
MERGE_CLOUD_TO_LOCAL=1
# Enable after reviewing a cloud→local dry-run / write cycle
MERGE_LOCAL_TO_CLOUD=0

# Optional overrides
# DUMP_DIR=/mnt/hdd/backups/cloud-sync
# MERGE_WORKDIR=/mnt/hdd/backups/cloud-sync/merge
# LOCK_FILE=/tmp/gp-merge-sync.lock

# --- Emergency overwrite only (sync-cloud-to-local-OVERWRITE.sh) — keep off ---
CLOUD_SYNC_OVERWRITE_ENABLED=0
# MIN_HRIS_BYTES=50000000
# MIN_CSM_BYTES=500000
# MIN_CLIENT_BYTES=500000

# --- HRIS (timelog / Directory) ---
# ref wavweetmtjoxzdirnfva
HRIS_PGHOST=aws-1-ap-southeast-1.pooler.supabase.com
HRIS_PGPORT=5432
HRIS_PGUSER=postgres.wavweetmtjoxzdirnfva
HRIS_PGPASSWORD=

# --- CSM ---
# ref zmlvljvznjxmesuzoynw
CSM_PGHOST=aws-0-ap-northeast-2.pooler.supabase.com
CSM_PGPORT=5432
CSM_PGUSER=postgres.zmlvljvznjxmesuzoynw
CSM_PGPASSWORD=

# --- GP-Client / timekeep ---
